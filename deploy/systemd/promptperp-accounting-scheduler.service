[Unit]
Description=PromptPerp investor report scheduler
After=local-fs.target

[Service]
Type=oneshot
User=promptperp-accounting
Group=promptperp-accounting
WorkingDirectory=/opt/promptperp
ExecStart=/opt/promptperp/.venv/bin/python -m promptperp.operations.accounting_service --database /var/lib/promptperp/accounting/accounting.sqlite3 run-scheduler --lease-path /var/lib/promptperp/accounting/scheduler.lease
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/promptperp/accounting
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictSUIDSGID=true
