[Unit]
Description=Publish PromptPerp deployment health, metrics and alert events
After=local-fs.target
OnFailure=promptperp-alert@%n.service

[Service]
Type=oneshot
User=promptperp-monitor
Group=promptperp-monitor
WorkingDirectory=/opt/promptperp/current-production
ExecStart=/opt/promptperp/current-production/runtime/.venv/bin/python -m promptperp.operations.deployment_service --root / monitor --stale-after-seconds 300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/promptperp /var/lib/promptperp
ReadWritePaths=/var/lib/promptperp/status /var/lib/promptperp/alerts
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
