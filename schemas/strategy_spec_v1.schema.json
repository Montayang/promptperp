{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/promptperp/strategy-spec-v1.schema.json",
  "title": "PromptPerp StrategySpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interface_version",
    "strategy_id",
    "name",
    "description",
    "data",
    "symbols",
    "indicators",
    "entry_rules",
    "exit_intent",
    "cooldown_events",
    "assumptions",
    "unresolved",
    "assertions",
    "scenarios"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "interface_version": {"const": 1},
    "strategy_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_kind", "interval", "max_age_seconds", "warmup"],
      "properties": {
        "event_kind": {"enum": ["bar", "ranking", "mark_price", "funding", "clock"]},
        "interval": {"type": "string", "pattern": "^[1-9][0-9]*[smhd]$"},
        "max_age_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "warmup": {"type": "integer", "minimum": 0, "maximum": 4096}
      }
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9]{2,20}USDT$"}
    },
    "indicators": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "field", "window"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "kind": {"enum": ["sma", "ema", "min", "max"]},
          "field": {"enum": ["open", "high", "low", "close", "volume", "mark_price", "funding_rate", "rank"]},
          "window": {"type": "integer", "minimum": 1, "maximum": 4096}
        }
      }
    },
    "entry_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "position_side", "reason", "when"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "position_side": {"enum": ["LONG", "SHORT"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 300},
          "when": {"type": "object"}
        }
      }
    },
    "exit_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["take_profit_ratio", "stop_loss_ratio"],
      "properties": {
        "take_profit_ratio": {"type": "string"},
        "stop_loss_ratio": {"type": "string"}
      }
    },
    "cooldown_events": {"type": "integer", "minimum": 0, "maximum": 100000},
    "assumptions": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
    "unresolved": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
    "assertions": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "events", "expect_signal", "expect_error"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "category": {"enum": ["normal", "no_signal", "boundary", "data_fault", "abnormal"]},
          "events": {"type": "array", "maxItems": 10000, "items": {"type": "object"}},
          "expect_signal": {"type": "boolean"},
          "expect_error": {"type": "boolean"}
        }
      }
    }
  }
}
