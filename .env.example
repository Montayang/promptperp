# PromptPerp never loads this file implicitly. Copy only the fields needed by an
# explicitly approved downstream integration and keep the result owner-readable.

# Binance USD-M credentials. The public examples do not use them.
API_KEY=
API_SECRET=
BASE_PATH=

# Optional accounting mail provider. Keep mail and trading credentials in separate
# service-specific files in production.
SENDER_EMAIL=
RECEIVER_EMAIL=
EMAIL_PASSWORD=
MAIL_ACCOUNT_EMAIL=
MAIL_APP_PASSWORD=
IMAP_HOST=
IMAP_PORT=
SMTP_HOST=
SMTP_PORT=
